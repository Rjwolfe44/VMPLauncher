<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>VmpLauncher.Core</RootNamespace>
    <Description>Pack/lock model, profiles, transactions, hashing, security and policy. No CKAN, no UI.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Security\trusted-keys.json" LogicalName="VmpLauncher.Core.Security.trusted-keys.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="VmpLauncher.Tests" />
    <InternalsVisibleTo Include="VmpLauncher.IntegrationTests" />
  </ItemGroup>
</Project>
