<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- ===== Space palette tokens =====
         Backgrounds are deep blue-black, text is cool off-white, the accent is Shikigami purple.
         Status colours are semantic and always paired with text in the UI. Contrast ≥ 7:1 for body text. -->
    <Color x:Key="Space.Bg.Base">#FF0B0D17</Color>
    <Color x:Key="Space.Bg.Layer">#FF12152A</Color>
    <Color x:Key="Space.Bg.LayerOnMica">#D912152A</Color>
    <Color x:Key="Space.Bg.Elevated">#FF1A1E38</Color>
    <Color x:Key="Space.Stroke.Subtle">#FF2A2F52</Color>
    <Color x:Key="Space.Text.Primary">#FFECEAF6</Color>
    <Color x:Key="Space.Text.Secondary">#FFA9A6C4</Color>
    <Color x:Key="Space.Text.Disabled">#FF6B6890</Color>
    <Color x:Key="Space.Accent">#FFB69CFF</Color>
    <Color x:Key="Space.Accent.Hover">#FFC8B3FF</Color>
    <Color x:Key="Space.Accent.Pressed">#FF9F82F0</Color>
    <Color x:Key="Space.Accent.OnAccent">#FF1A1033</Color>
    <Color x:Key="Space.Status.Online">#FF4ADE80</Color>
    <Color x:Key="Space.Status.Warning">#FFFBBF24</Color>
    <Color x:Key="Space.Status.Error">#FFF87171</Color>
    <Color x:Key="Space.Status.Info">#FF60A5FA</Color>
    <Color x:Key="Space.Status.Offline">#FF6B7280</Color>

    <SolidColorBrush x:Key="Space.Bg.BaseBrush" Color="{StaticResource Space.Bg.Base}" />
    <SolidColorBrush x:Key="Space.Bg.LayerBrush" Color="{StaticResource Space.Bg.Layer}" />
    <SolidColorBrush x:Key="Space.Bg.LayerOnMicaBrush" Color="{StaticResource Space.Bg.LayerOnMica}" />
    <SolidColorBrush x:Key="Space.Bg.ElevatedBrush" Color="{StaticResource Space.Bg.Elevated}" />
    <SolidColorBrush x:Key="Space.Stroke.SubtleBrush" Color="{StaticResource Space.Stroke.Subtle}" />
    <SolidColorBrush x:Key="Space.Text.PrimaryBrush" Color="{StaticResource Space.Text.Primary}" />
    <SolidColorBrush x:Key="Space.Text.SecondaryBrush" Color="{StaticResource Space.Text.Secondary}" />
    <SolidColorBrush x:Key="Space.Text.DisabledBrush" Color="{StaticResource Space.Text.Disabled}" />
    <SolidColorBrush x:Key="Space.AccentBrush" Color="{StaticResource Space.Accent}" />
    <SolidColorBrush x:Key="Space.Accent.HoverBrush" Color="{StaticResource Space.Accent.Hover}" />
    <SolidColorBrush x:Key="Space.Accent.PressedBrush" Color="{StaticResource Space.Accent.Pressed}" />
    <SolidColorBrush x:Key="Space.Accent.OnAccentBrush" Color="{StaticResource Space.Accent.OnAccent}" />
    <SolidColorBrush x:Key="Space.Status.OnlineBrush" Color="{StaticResource Space.Status.Online}" />
    <SolidColorBrush x:Key="Space.Status.WarningBrush" Color="{StaticResource Space.Status.Warning}" />
    <SolidColorBrush x:Key="Space.Status.ErrorBrush" Color="{StaticResource Space.Status.Error}" />
    <SolidColorBrush x:Key="Space.Status.InfoBrush" Color="{StaticResource Space.Status.Info}" />
    <SolidColorBrush x:Key="Space.Status.OfflineBrush" Color="{StaticResource Space.Status.Offline}" />

    <!-- Override a handful of WPF-UI theme brushes so the Fluent controls sit on the space palette. -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource Space.Bg.Base}" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource Space.Text.Primary}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource Space.Text.Secondary}" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="{StaticResource Space.Text.Disabled}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource Space.Bg.LayerOnMica}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource Space.Stroke.Subtle}" />

    <!-- Shape and spacing -->
    <CornerRadius x:Key="Space.Radius.Control">8</CornerRadius>
    <CornerRadius x:Key="Space.Radius.Card">12</CornerRadius>
    <CornerRadius x:Key="Space.Radius.Hero">16</CornerRadius>
    <Thickness x:Key="Space.Page.Padding">32,24,32,24</Thickness>

    <!-- Typography -->
    <FontFamily x:Key="Space.Font.Ui">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Space.Font.Mono">Cascadia Mono, Consolas</FontFamily>

    <Style x:Key="Space.Style.Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Space.Font.Ui}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Space.Text.PrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Space.Style.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Space.Font.Ui}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Space.Text.PrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Space.Style.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Space.Font.Ui}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Space.Text.PrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Space.Style.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Space.Style.Body}">
        <Setter Property="Foreground" Value="{StaticResource Space.Text.SecondaryBrush}" />
    </Style>
    <Style x:Key="Space.Style.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Space.Font.Ui}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Space.Text.SecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Space.Style.Mono" TargetType="TextBlock" BasedOn="{StaticResource Space.Style.Body}">
        <Setter Property="FontFamily" Value="{StaticResource Space.Font.Mono}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Card surface used across pages -->
    <Style x:Key="Space.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Space.Bg.LayerOnMicaBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Space.Stroke.SubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Space.Radius.Card}" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <!-- Static starfield used behind the hero when a pack has no banner -->
    <DrawingBrush x:Key="Space.StarfieldBrush" TileMode="Tile" Viewport="0,0,240,240" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing>
                    <GeometryDrawing.Brush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF0B0D17" Offset="0" />
                            <GradientStop Color="#FF151A38" Offset="1" />
                        </LinearGradientBrush>
                    </GeometryDrawing.Brush>
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,240,240" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#CCECEAF6">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="12,30" RadiusX="1" RadiusY="1" />
                            <EllipseGeometry Center="58,12" RadiusX="0.7" RadiusY="0.7" />
                            <EllipseGeometry Center="97,71" RadiusX="1.2" RadiusY="1.2" />
                            <EllipseGeometry Center="140,25" RadiusX="0.8" RadiusY="0.8" />
                            <EllipseGeometry Center="181,96" RadiusX="1" RadiusY="1" />
                            <EllipseGeometry Center="212,48" RadiusX="0.6" RadiusY="0.6" />
                            <EllipseGeometry Center="33,130" RadiusX="0.9" RadiusY="0.9" />
                            <EllipseGeometry Center="76,175" RadiusX="1.3" RadiusY="1.3" />
                            <EllipseGeometry Center="122,150" RadiusX="0.7" RadiusY="0.7" />
                            <EllipseGeometry Center="166,206" RadiusX="1" RadiusY="1" />
                            <EllipseGeometry Center="205,165" RadiusX="0.8" RadiusY="0.8" />
                            <EllipseGeometry Center="228,222" RadiusX="1.1" RadiusY="1.1" />
                            <EllipseGeometry Center="18,214" RadiusX="0.6" RadiusY="0.6" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#66B69CFF">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="150,110" RadiusX="1.6" RadiusY="1.6" />
                            <EllipseGeometry Center="45,70" RadiusX="1.4" RadiusY="1.4" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
