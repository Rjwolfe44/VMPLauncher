<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- ===== Space palette =====
         Deep blue-black surfaces, cool off-white text, Shikigami purple accent. Status colours are semantic and are
         always paired with text or an icon. Body text contrast >= 7:1 on every surface. -->
    <Color x:Key="Space.Bg.Base">#FF0A0C18</Color>
    <Color x:Key="Space.Bg.Sidebar">#FF0D1022</Color>
    <Color x:Key="Space.Bg.Layer">#FF13162B</Color>
    <Color x:Key="Space.Bg.LayerOnMica">#F213162B</Color>
    <Color x:Key="Space.Bg.Elevated">#FF1B1F3A</Color>
    <Color x:Key="Space.Bg.Hover">#FF20244A</Color>
    <Color x:Key="Space.Bg.Input">#FF0F1226</Color>
    <Color x:Key="Space.Stroke.Subtle">#FF262B4D</Color>
    <Color x:Key="Space.Stroke.Strong">#FF363C6A</Color>
    <Color x:Key="Space.Text.Primary">#FFECEAF6</Color>
    <Color x:Key="Space.Text.Secondary">#FFA9A6C4</Color>
    <Color x:Key="Space.Text.Disabled">#FF6E6B92</Color>
    <Color x:Key="Space.Accent">#FFB69CFF</Color>
    <Color x:Key="Space.Accent.Hover">#FFC9B5FF</Color>
    <Color x:Key="Space.Accent.Pressed">#FF9E83F2</Color>
    <Color x:Key="Space.Accent.Deep">#FF7C5CE0</Color>
    <Color x:Key="Space.Accent.OnAccent">#FF1A1033</Color>
    <Color x:Key="Space.Accent.Soft">#FF262050</Color>
    <Color x:Key="Space.Status.Online">#FF4ADE80</Color>
    <Color x:Key="Space.Status.Warning">#FFFBBF24</Color>
    <Color x:Key="Space.Status.Error">#FFF87171</Color>
    <Color x:Key="Space.Status.Info">#FF60A5FA</Color>
    <Color x:Key="Space.Status.Offline">#FF6B7280</Color>

    <SolidColorBrush x:Key="Space.Bg.BaseBrush" Color="{StaticResource Space.Bg.Base}" />
    <SolidColorBrush x:Key="Space.Bg.SidebarBrush" Color="{StaticResource Space.Bg.Sidebar}" />
    <SolidColorBrush x:Key="Space.Bg.LayerBrush" Color="{StaticResource Space.Bg.Layer}" />
    <SolidColorBrush x:Key="Space.Bg.LayerOnMicaBrush" Color="{StaticResource Space.Bg.LayerOnMica}" />
    <SolidColorBrush x:Key="Space.Bg.ElevatedBrush" Color="{StaticResource Space.Bg.Elevated}" />
    <SolidColorBrush x:Key="Space.Bg.HoverBrush" Color="{StaticResource Space.Bg.Hover}" />
    <SolidColorBrush x:Key="Space.Bg.InputBrush" Color="{StaticResource Space.Bg.Input}" />
    <SolidColorBrush x:Key="Space.Stroke.SubtleBrush" Color="{StaticResource Space.Stroke.Subtle}" />
    <SolidColorBrush x:Key="Space.Stroke.StrongBrush" Color="{StaticResource Space.Stroke.Strong}" />
    <SolidColorBrush x:Key="Space.Text.PrimaryBrush" Color="{StaticResource Space.Text.Primary}" />
    <SolidColorBrush x:Key="Space.Text.SecondaryBrush" Color="{StaticResource Space.Text.Secondary}" />
    <SolidColorBrush x:Key="Space.Text.DisabledBrush" Color="{StaticResource Space.Text.Disabled}" />
    <SolidColorBrush x:Key="Space.AccentBrush" Color="{StaticResource Space.Accent}" />
    <SolidColorBrush x:Key="Space.Accent.HoverBrush" Color="{StaticResource Space.Accent.Hover}" />
    <SolidColorBrush x:Key="Space.Accent.PressedBrush" Color="{StaticResource Space.Accent.Pressed}" />
    <SolidColorBrush x:Key="Space.Accent.OnAccentBrush" Color="{StaticResource Space.Accent.OnAccent}" />
    <SolidColorBrush x:Key="Space.Accent.SoftBrush" Color="{StaticResource Space.Accent.Soft}" />
    <SolidColorBrush x:Key="Space.Status.OnlineBrush" Color="{StaticResource Space.Status.Online}" />
    <SolidColorBrush x:Key="Space.Status.WarningBrush" Color="{StaticResource Space.Status.Warning}" />
    <SolidColorBrush x:Key="Space.Status.ErrorBrush" Color="{StaticResource Space.Status.Error}" />
    <SolidColorBrush x:Key="Space.Status.InfoBrush" Color="{StaticResource Space.Status.Info}" />
    <SolidColorBrush x:Key="Space.Status.OfflineBrush" Color="{StaticResource Space.Status.Offline}" />
    <SolidColorBrush x:Key="Space.Scroll.ThumbBrush" Color="#FF3A4070" />
    <SolidColorBrush x:Key="Space.Scroll.ThumbHoverBrush" Color="#FF5A5F96" />

    <LinearGradientBrush x:Key="Space.AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFC9B5FF" Offset="0" />
        <GradientStop Color="#FFB69CFF" Offset="0.45" />
        <GradientStop Color="#FF9478F0" Offset="1" />
    </LinearGradientBrush>

    <!-- Window background: deep navy, plus two soft nebula glows layered on top (see MainWindow). -->
    <LinearGradientBrush x:Key="Space.WindowBackgroundBrush" StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Color="#FF0F1228" Offset="0" />
        <GradientStop Color="#FF0A0C18" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="Space.NebulaBrush" Center="0.88,0.02" GradientOrigin="0.88,0.02" RadiusX="0.55" RadiusY="0.8">
        <GradientStop Color="#2EB69CFF" Offset="0" />
        <GradientStop Color="#00B69CFF" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Space.NebulaBlueBrush" Center="0.12,1.05" GradientOrigin="0.12,1.05" RadiusX="0.5" RadiusY="0.6">
        <GradientStop Color="#1A60A5FA" Offset="0" />
        <GradientStop Color="#0060A5FA" Offset="1" />
    </RadialGradientBrush>

    <!-- Fluent control brushes re-pointed at the space palette (merged after the WPF-UI theme). -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="{StaticResource Space.Bg.Base}" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{StaticResource Space.Text.Primary}" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{StaticResource Space.Text.Secondary}" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="{StaticResource Space.Text.Secondary}" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="{StaticResource Space.Text.Disabled}" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{StaticResource Space.Bg.Layer}" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="{StaticResource Space.Stroke.Subtle}" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FF1D2140" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FF242850" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#FF191C38" />
    <SolidColorBrush x:Key="ControlFillColorInputActiveBrush" Color="{StaticResource Space.Bg.Input}" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="{StaticResource Space.Stroke.Subtle}" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="{StaticResource Space.Stroke.Strong}" />

    <!-- Shape and spacing -->
    <CornerRadius x:Key="Space.Radius.Control">8</CornerRadius>
    <CornerRadius x:Key="Space.Radius.Card">14</CornerRadius>
    <CornerRadius x:Key="Space.Radius.Hero">18</CornerRadius>
    <Thickness x:Key="Space.Page.Padding">36,8,36,32</Thickness>

    <!-- Typography -->
    <FontFamily x:Key="Space.Font.Ui">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Space.Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Space.Font.Mono">Cascadia Mono, Consolas</FontFamily>

    <Style x:Key="Space.Style.Hero" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Space.Font.Ui}" />
        <Setter Property="FontSize" Value="36" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Space.Text.PrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Space.Style.Display" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Space.Font.Ui}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Space.Text.PrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Space.Style.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Space.Font.Ui}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Space.Text.PrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Space.Style.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Space.Font.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource Space.Text.PrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Space.Style.Secondary" TargetType="TextBlock" BasedOn="{StaticResource Space.Style.Body}">
        <Setter Property="Foreground" Value="{StaticResource Space.Text.SecondaryBrush}" />
    </Style>
    <Style x:Key="Space.Style.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Space.Font.Text}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Space.Text.SecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Space.Style.Overline" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Space.Font.Text}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Space.Text.DisabledBrush}" />
    </Style>
    <Style x:Key="Space.Style.Mono" TargetType="TextBlock" BasedOn="{StaticResource Space.Style.Body}">
        <Setter Property="FontFamily" Value="{StaticResource Space.Font.Mono}" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="Space.Style.Stat" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Space.Font.Ui}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Space.Text.PrimaryBrush}" />
    </Style>

    <!-- Card surface used across pages -->
    <Style x:Key="Space.Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Space.Bg.LayerBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Space.Stroke.SubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Space.Radius.Card}" />
        <Setter Property="Padding" Value="22" />
    </Style>
    <Style x:Key="Space.Card.Accent" TargetType="Border" BasedOn="{StaticResource Space.Card}">
        <Setter Property="BorderBrush" Value="{StaticResource Space.AccentBrush}" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FF1E1A42" Offset="0" />
                    <GradientStop Color="#FF13162B" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Static starfield used behind heroes -->
    <DrawingBrush x:Key="Space.StarfieldBrush" TileMode="Tile" Viewport="0,0,260,260" ViewportUnits="Absolute" Stretch="None">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <!-- Solid tile base: a per-tile gradient shows seams between tiles. -->
                <GeometryDrawing Brush="#FF10132A">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,260,260" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#CCECEAF6">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="12,30" RadiusX="1" RadiusY="1" />
                            <EllipseGeometry Center="58,12" RadiusX="0.7" RadiusY="0.7" />
                            <EllipseGeometry Center="97,71" RadiusX="1.2" RadiusY="1.2" />
                            <EllipseGeometry Center="140,25" RadiusX="0.8" RadiusY="0.8" />
                            <EllipseGeometry Center="181,96" RadiusX="1" RadiusY="1" />
                            <EllipseGeometry Center="232,48" RadiusX="0.6" RadiusY="0.6" />
                            <EllipseGeometry Center="33,130" RadiusX="0.9" RadiusY="0.9" />
                            <EllipseGeometry Center="76,185" RadiusX="1.3" RadiusY="1.3" />
                            <EllipseGeometry Center="122,150" RadiusX="0.7" RadiusY="0.7" />
                            <EllipseGeometry Center="166,216" RadiusX="1" RadiusY="1" />
                            <EllipseGeometry Center="215,165" RadiusX="0.8" RadiusY="0.8" />
                            <EllipseGeometry Center="248,232" RadiusX="1.1" RadiusY="1.1" />
                            <EllipseGeometry Center="18,234" RadiusX="0.6" RadiusY="0.6" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#80B69CFF">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="150,110" RadiusX="1.6" RadiusY="1.6" />
                            <EllipseGeometry Center="45,70" RadiusX="1.4" RadiusY="1.4" />
                            <EllipseGeometry Center="205,205" RadiusX="1.2" RadiusY="1.2" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>

    <!-- ===== Scrolling: a slim, always-visible scrollbar (the stock Fluent one hides itself) ===== -->
    <Style x:Key="Space.ScrollThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" CornerRadius="4" Background="{StaticResource Space.Scroll.ThumbBrush}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource Space.Scroll.ThumbHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource Space.AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Space.ScrollPageButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Space.ScrollBar" TargetType="ScrollBar">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Border Background="Transparent" Padding="3,6">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Space.ScrollPageButton}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Space.ScrollThumb}" MinHeight="32" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Space.ScrollPageButton}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="12" />
                <Setter Property="MinHeight" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Border Background="Transparent" Padding="6,3">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource Space.ScrollPageButton}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource Space.ScrollThumb}" MinWidth="32" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource Space.ScrollPageButton}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Implicit: every ScrollViewer (pages, lists, logs) uses the visible scrollbar. -->
    <Style TargetType="ScrollViewer">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollViewer">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Row="0" Grid.Column="0"
                                                Margin="{TemplateBinding Padding}"
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                CanContentScroll="{TemplateBinding CanContentScroll}" />
                        <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Row="0" Grid.Column="1" Style="{StaticResource Space.ScrollBar}"
                                   Orientation="Vertical"
                                   Value="{TemplateBinding VerticalOffset}" Maximum="{TemplateBinding ScrollableHeight}"
                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                   AutomationProperties.AutomationId="VerticalScrollBar" />
                        <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Grid.Column="0" Style="{StaticResource Space.ScrollBar}"
                                   Orientation="Horizontal"
                                   Value="{TemplateBinding HorizontalOffset}" Maximum="{TemplateBinding ScrollableWidth}"
                                   ViewportSize="{TemplateBinding ViewportWidth}"
                                   Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Page scroller: vertical only, content centred with a max width. -->
    <Style x:Key="Space.PageScroll" TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="PanningMode" Value="VerticalOnly" />
    </Style>
</ResourceDictionary>
