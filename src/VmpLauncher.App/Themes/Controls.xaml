<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:VmpLauncher.App.ViewModels"
    xmlns:svc="clr-namespace:VmpLauncher.App.Services">

    <!-- Requirement / preflight row: icon + label + detail -->
    <DataTemplate x:Key="RequirementRowTemplate" DataType="{x:Type vm:RequirementRow}">
        <Grid Margin="0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon Grid.Column="0" FontSize="18" VerticalAlignment="Center"
                           Symbol="{Binding Ok, Converter={StaticResource BoolToSymbol}}"
                           Foreground="{Binding Ok, Converter={StaticResource BoolToStatusBrush}}" />
            <TextBlock Grid.Column="1" Style="{StaticResource Space.Style.Body}" Text="{Binding Label}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Style="{StaticResource Space.Style.Caption}" Text="{Binding Detail}" VerticalAlignment="Center" MaxWidth="420" TextTrimming="CharacterEllipsis" />
        </Grid>
    </DataTemplate>

    <!-- Error card -->
    <DataTemplate x:Key="ErrorCardTemplate" DataType="{x:Type svc:UserFacingError}">
        <Border Background="{StaticResource Space.Bg.ElevatedBrush}" BorderBrush="{StaticResource Space.Status.ErrorBrush}" BorderThickness="1" CornerRadius="{StaticResource Space.Radius.Card}" Padding="16" Margin="0,12,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ErrorCircle24" Foreground="{StaticResource Space.Status.ErrorBrush}" FontSize="20" Margin="0,0,10,0" />
                    <TextBlock Style="{StaticResource Space.Style.Title}" FontSize="16" Text="{Binding Title}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Space.Style.Body}" Margin="0,8,0,0" Text="{Binding Message}" />
                <TextBlock Style="{StaticResource Space.Style.Secondary}" Margin="0,6,0,0" Text="{Binding Suggestion}" Visibility="{Binding Suggestion, Converter={StaticResource NullToVisibility}}" />
                <Expander Header="Details" Margin="0,8,0,0" Visibility="{Binding Details, Converter={StaticResource NullToVisibility}}">
                    <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource Space.Font.Mono}" FontSize="12" MaxHeight="220" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" />
                </Expander>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- Badge pill -->
    <Style x:Key="Space.Badge" TargetType="Border">
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{StaticResource Space.Bg.ElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource Space.Stroke.SubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Section heading -->
    <Style x:Key="Space.SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Space.Style.Title}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
</ResourceDictionary>
