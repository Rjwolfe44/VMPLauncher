<UserControl
    x:Class="VmpLauncher.App.Views.Pages.InstallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:VmpLauncher.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:InstallViewModel}">
    <!-- No page scroller here: the log list scrolls itself and fills the remaining height. -->
    <Grid Margin="{StaticResource Space.Page.Padding}" MaxWidth="1120">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource Space.PageTitle}" Text="Activity" />
            <TextBlock Style="{StaticResource Space.Style.Secondary}" Text="What the launcher is doing right now, step by step." />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Space.Card}" Margin="0,20,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="46" Height="46" CornerRadius="12" Background="{StaticResource Space.Accent.SoftBrush}" VerticalAlignment="Top" Margin="0,0,16,0">
                    <Grid>
                        <ui:ProgressRing IsIndeterminate="True" Width="26" Height="26" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                        <ui:SymbolIcon Symbol="{Binding StateKind, Converter={StaticResource StatusKindToSymbol}}" Filled="True" FontSize="24"
                                       Foreground="{Binding StateKind, Converter={StaticResource StatusKindToBrush}}"
                                       Visibility="{Binding IsRunning, Converter={StaticResource InvertedBoolToVisibility}}" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource Space.Style.Title}" Text="{Binding Title}" />
                    <TextBlock Style="{StaticResource Space.Style.Secondary}" Text="{Binding Message}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}" />
                    <ProgressBar Style="{StaticResource Space.Progress}" Margin="0,14,0,0" Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding Indeterminate}"
                                 Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource Space.Style.Caption}" Text="{Binding Percent, StringFormat={}{0}%}" Margin="0,0,18,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Style="{StaticResource Space.Style.Caption}" Text="{Binding Speed}" Margin="0,0,18,0" Visibility="{Binding Speed, Converter={StaticResource NullToVisibility}}" />
                        <TextBlock Style="{StaticResource Space.Style.Caption}" Text="{Binding TimeLeft}" Margin="0,0,18,0" Visibility="{Binding TimeLeft, Converter={StaticResource NullToVisibility}}" />
                        <TextBlock Style="{StaticResource Space.Style.Caption}" Text="{Binding Elapsed}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Space.Style.Caption}" Margin="0,10,0,0" Text="Cancelling puts your previous working setup back; nothing is left half-installed."
                               Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <ui:Button Grid.Column="2" Content="Cancel" Command="{Binding CancelCommand}" Icon="{ui:SymbolIcon Dismiss24}" VerticalAlignment="Top" Margin="16,0,0,0"
                           Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button Grid.Column="2" Content="Back to Home" Command="{Binding GoHomeCommand}" Icon="{ui:SymbolIcon Home24}" VerticalAlignment="Top" Margin="16,0,0,0"
                           Visibility="{Binding IsRunning, Converter={StaticResource InvertedBoolToVisibility}}" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Space.Card}" Margin="0,16,0,0" Padding="22,18,10,12">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,12,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Space.Button.Link}" Content="Copy log" Command="{Binding CopyLogCommand}" />
                    <TextBlock Style="{StaticResource Space.SectionTitle}" Text="Log" Margin="0" VerticalAlignment="Center" />
                </DockPanel>
                <Grid>
                    <TextBlock Style="{StaticResource Space.Style.Caption}" Text="Nothing has run yet in this session." Margin="0,6,0,0"
                               Visibility="{Binding HasHistory, Converter={StaticResource InvertedBoolToVisibility}}" />
                    <ListBox x:Name="LogList" ItemsSource="{Binding Lines}" Background="Transparent" BorderThickness="0"
                             FontFamily="{StaticResource Space.Font.Mono}" FontSize="12"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="OverridesDefaultStyle" Value="True" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter Margin="0,1" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource Space.Text.SecondaryBrush}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
