<UserControl
    x:Class="VmpLauncher.App.Views.Pages.DoctorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:VmpLauncher.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:DoctorViewModel}">
    <ScrollViewer Style="{StaticResource Space.PageScroll}">
        <StackPanel Margin="{StaticResource Space.Page.Padding}" MaxWidth="1000">
            <TextBlock Style="{StaticResource Space.PageTitle}" Text="Doctor" />
            <TextBlock Style="{StaticResource Space.Style.Secondary}" Text="Fixes for the pack copy, and why you can't join." />

            <!-- Fix the pack copy: every way out of a stuck install, always reachable -->
            <Border Style="{StaticResource Space.Card}" Padding="20,18" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Space.SectionTitle}" Text="Fix the pack copy" />
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding PackStatusKind, Converter={StaticResource StatusKindToBrush}}" />
                        <TextBlock Style="{StaticResource Space.Style.Body}" Text="{Binding PackStatus}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Space.Style.Secondary}" Margin="0,10,0,0" Text="{Binding LastFix}" Foreground="{StaticResource Space.Status.OnlineBrush}"
                               Visibility="{Binding LastFix, Converter={StaticResource NullToVisibility}}" />
                    <WrapPanel Margin="0,14,0,0">
                        <ui:Button Content="Check and repair files" Icon="{ui:SymbolIcon Wrench24}" Appearance="Primary" Margin="0,0,8,8"
                                   Command="{Binding RepairPackCommand}" IsEnabled="{Binding CanRepair}"
                                   ToolTip="Checks every pack file, puts back what changed or went missing, and moves DLLs the pack doesn't know to the quarantine folder" />
                        <ui:Button Content="Restore" Icon="{ui:SymbolIcon History24}" Appearance="Primary" Margin="0,0,8,8"
                                   Command="{Binding RestorePackCommand}" Visibility="{Binding CanRestore, Converter={StaticResource BoolToVisibility}}"
                                   ToolTip="Finishes or undoes an install or update that was interrupted" />
                        <ui:Button Content="Reinstall the pack copy…" Icon="{ui:SymbolIcon ArrowReset24}" Margin="0,0,8,8"
                                   Command="{Binding ReinstallPackCommand}" IsEnabled="{Binding CanReinstall}"
                                   ToolTip="Builds a fresh copy and keeps your saves, craft, screenshots and settings. Asks first." />
                        <ui:Button Content="Copy report" Icon="{ui:SymbolIcon Copy24}" Margin="0,0,8,8" Command="{Binding CopyPackReportCommand}"
                                   ToolTip="Copies versions, the pack state and the end of the log (passwords and your user name removed) to send to the host" />
                        <ui:Button Content="Send my logs" Icon="{ui:SymbolIcon FolderZip24}" Margin="0,0,8,8" Command="{Binding Recovery.SendLogsCommand}"
                                   ToolTip="Makes one small zip on your Desktop with the game log, the launcher logs and a report (your user name and passwords removed), then shows it in Explorer. Drop it in Discord for the host." />
                        <ui:Button Content="Open logs" Icon="{ui:SymbolIcon FolderOpen24}" Margin="0,0,8,8" Command="{Binding OpenLogsCommand}" />
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8" Visibility="{Binding Recovery.IsSendingLogs, Converter={StaticResource BoolToVisibility}}">
                        <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" />
                        <TextBlock Style="{StaticResource Space.Style.Secondary}" Text="{Binding Recovery.LogsStatus}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Space.Style.Caption}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Text="Try them in order: Repair fixes changed or missing files, Restore fixes an interrupted update, and Reinstall rebuilds everything else while keeping your own files. Your own KSP folder is never touched." />
                    <TextBlock Style="{StaticResource Space.Style.Caption}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="Still wrong, or the game acts up? Send my logs puts the game log (shrunk to a few MB), the launcher logs and a report in one zip on your Desktop, with your Windows user name and passwords removed. Drop it in Discord for the host." />
                    <ContentControl Content="{Binding PackError}" ContentTemplate="{StaticResource ErrorCardTemplate}" Visibility="{Binding PackError, Converter={StaticResource NullToVisibility}}" Focusable="False" />
                </StackPanel>
            </Border>

            <DockPanel Margin="0,28,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <ui:Button Content="Copy report" Command="{Binding CopyReportCommand}" Icon="{ui:SymbolIcon Copy24}" Margin="0,0,8,0"
                               ToolTip="Copies a report with passwords and your user name removed, to send to the host"
                               Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Content="Run checks" Command="{Binding RunCommand}" Appearance="Primary" Icon="{ui:SymbolIcon Stethoscope24}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource Space.SectionTitle}" Text="Connection" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <ui:ProgressRing IsIndeterminate="True" Width="16" Height="16" Margin="0,0,8,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                        <Ellipse Width="9" Height="9" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding HeadlineKind, Converter={StaticResource StatusKindToBrush}}"
                                 Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Style="{StaticResource Space.Style.Secondary}" Text="{Binding Headline}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
            <ContentControl Content="{Binding Error}" ContentTemplate="{StaticResource ErrorCardTemplate}" Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}" Focusable="False" />
            <ItemsControl ItemsSource="{Binding Steps}" Margin="0,20,0,0" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DoctorStepViewModel}">
                        <Border Style="{StaticResource Space.Card}" Padding="18,14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" FontSize="22" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,1,0,0" Filled="True"
                                               Symbol="{Binding StatusKind, Converter={StaticResource StatusKindToSymbol}}"
                                               Foreground="{Binding StatusKind, Converter={StaticResource StatusKindToBrush}}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource Space.Style.Body}" FontWeight="SemiBold" Text="{Binding Title}" />
                                    <TextBlock Style="{StaticResource Space.Style.Secondary}" Text="{Binding Summary}" Margin="0,2,0,0" />
                                    <ToggleButton x:Name="DetailsToggle" Style="{StaticResource Space.DetailsToggle}" Content="Details" Margin="-6,4,0,0"
                                                  Visibility="{Binding Details, Converter={StaticResource NullToVisibility}}" />
                                    <Border Margin="0,6,0,0" Padding="12,8" CornerRadius="8" Background="{StaticResource Space.Bg.InputBrush}"
                                            Visibility="{Binding IsChecked, ElementName=DetailsToggle, Converter={StaticResource BoolToVisibility}}">
                                        <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource Space.Font.Mono}" FontSize="12"
                                                 Background="Transparent" BorderThickness="0" Padding="0" Foreground="{StaticResource Space.Text.SecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <ui:Button Grid.Column="2" Content="{Binding FixLabel}" VerticalAlignment="Top" Margin="12,0,0,0" Appearance="Primary"
                                           Command="{Binding DataContext.ApplyFixCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                                           Visibility="{Binding FixLabel, Converter={StaticResource NullToVisibility}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
