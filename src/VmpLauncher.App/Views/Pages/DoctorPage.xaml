<Page
    x:Class="VmpLauncher.App.Views.Pages.DoctorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:VmpLauncher.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:DoctorViewModel}"
    Title="Doctor">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource Space.Page.Padding}" MaxWidth="1000">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <ui:Button Content="Copy report" Command="{Binding CopyReportCommand}" Icon="{ui:SymbolIcon Copy24}" Margin="0,0,8,0" Visibility="{Binding HasReport, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button Content="Run checks" Command="{Binding RunCommand}" Appearance="Primary" Icon="{ui:SymbolIcon Stethoscope24}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource Space.Style.Display}" Text="Connection Doctor" />
                    <TextBlock Style="{StaticResource Space.Style.Secondary}" Margin="0,6,0,0" Text="{Binding Headline}" />
                </StackPanel>
            </DockPanel>
            <ContentControl Content="{Binding Error}" ContentTemplate="{StaticResource ErrorCardTemplate}" Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}" />
            <ui:ProgressRing IsIndeterminate="True" Width="28" Height="28" HorizontalAlignment="Left" Margin="0,16,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Steps}" Margin="0,16,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DoctorStepViewModel}">
                        <Border Style="{StaticResource Space.Card}" Padding="14" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" FontSize="20" VerticalAlignment="Top" Margin="0,2,0,0"
                                               Symbol="{Binding StatusKind, Converter={StaticResource StatusKindToSymbol}}"
                                               Foreground="{Binding StatusKind, Converter={StaticResource StatusKindToBrush}}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource Space.Style.Body}" FontWeight="SemiBold" Text="{Binding Title}" />
                                    <TextBlock Style="{StaticResource Space.Style.Secondary}" Text="{Binding Summary}" Margin="0,2,0,0" />
                                    <Expander Header="Details" Margin="0,6,0,0" Visibility="{Binding Details, Converter={StaticResource NullToVisibility}}">
                                        <TextBlock Style="{StaticResource Space.Style.Mono}" Text="{Binding Details}" TextWrapping="Wrap" FontSize="12" />
                                    </Expander>
                                </StackPanel>
                                <ui:Button Grid.Column="2" Content="{Binding FixLabel}" VerticalAlignment="Top" Margin="12,0,0,0"
                                           Command="{Binding DataContext.ApplyFixCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"
                                           Visibility="{Binding FixLabel, Converter={StaticResource NullToVisibility}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
