<UserControl
    x:Class="VmpLauncher.App.Views.Pages.ModsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:VmpLauncher.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:ModsViewModel}">
    <UserControl.Resources>
        <Style x:Key="FilterChip" TargetType="RadioButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{StaticResource Space.Text.SecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="16" Padding="14,6" Background="{StaticResource Space.Bg.ElevatedBrush}" BorderBrush="{StaticResource Space.Stroke.SubtleBrush}" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Space.Stroke.StrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Space.Accent.SoftBrush}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Space.AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource Space.Text.PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{StaticResource Space.Page.Padding}" MaxWidth="1120">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource Space.PageTitle}" Text="Mods" />
            <TextBlock Style="{StaticResource Space.Style.Secondary}" Text="{Binding Summary}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="420" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Search mods" Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True"
                        AutomationProperties.Name="Search mods" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <RadioButton Style="{StaticResource FilterChip}" GroupName="filter" IsChecked="True" Content="All" Command="{Binding SetFilterCommand}" CommandParameter="all" />
                <RadioButton Style="{StaticResource FilterChip}" GroupName="filter" Content="Custom" Command="{Binding SetFilterCommand}" CommandParameter="custom" />
                <RadioButton Style="{StaticResource FilterChip}" GroupName="filter" Content="Private" Command="{Binding SetFilterCommand}" CommandParameter="private" />
                <RadioButton Style="{StaticResource FilterChip}" GroupName="filter" Content="Dependencies" Command="{Binding SetFilterCommand}" CommandParameter="deps" />
            </StackPanel>
            <TextBlock Grid.Column="2" Style="{StaticResource Space.Style.Caption}" Text="{Binding CountLine}" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" Margin="16,0,0,0" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Space.Card}" Padding="6,6,4,6">
            <Grid>
                <TextBlock Style="{StaticResource Space.Style.Secondary}" Text="No mods match." Margin="18" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                <ListBox ItemsSource="{Binding Mods}" Background="Transparent" BorderThickness="0"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="OverridesDefaultStyle" Value="True" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row" CornerRadius="10" Padding="14,10" Margin="0,1" Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Space.Bg.ElevatedBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ModRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Space.Style.Body}" FontWeight="SemiBold" Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource Space.Style.Caption}" Text="{Binding Summary}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}"
                                               Visibility="{Binding Summary, Converter={StaticResource NullToVisibility}}" />
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource Space.Badge}" BorderBrush="{Binding BadgeKind, Converter={StaticResource StatusKindToBrush}}" Margin="12,0"
                                        Visibility="{Binding Badge, Converter={StaticResource NullToVisibility}}">
                                    <TextBlock Style="{StaticResource Space.Style.Caption}" Text="{Binding Badge}" Foreground="{StaticResource Space.Text.PrimaryBrush}" />
                                </Border>
                                <TextBlock Grid.Column="2" Style="{StaticResource Space.Style.Mono}" FontSize="12" Foreground="{StaticResource Space.Text.SecondaryBrush}" Text="{Binding Version}"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Identifier}" />
                                <TextBlock Grid.Column="3" Style="{StaticResource Space.Style.Caption}" Text="{Binding Size}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
