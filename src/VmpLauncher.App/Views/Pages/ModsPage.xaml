<UserControl
    x:Class="VmpLauncher.App.Views.Pages.ModsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:VmpLauncher.App.ViewModels"
    xmlns:svc="clr-namespace:VmpLauncher.App.Services"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="Root"
    d:DataContext="{d:DesignInstance vm:ModsViewModel}">
    <UserControl.Resources>
        <Style x:Key="TabChip" TargetType="RadioButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="{StaticResource Space.Text.SecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="17" Padding="16,7" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Space.Bg.HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Space.Accent.SoftBrush}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Space.AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource Space.Text.PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RowAction" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Appearance" Value="Secondary" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ActionIsPrimary}" Value="True">
                    <Setter Property="Appearance" Value="Primary" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type vm:DescriptionText}">
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="•" Margin="2,0,8,0" Foreground="{StaticResource Space.AccentBrush}" Visibility="{Binding Bullet, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="{Binding Size}" TextWrapping="Wrap" Foreground="{StaticResource Space.Text.PrimaryBrush}"
                           FontFamily="{StaticResource Space.Font.Text}" LineHeight="21">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Bold}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Margin" Value="0,6,0,0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DescriptionImage}">
            <Border CornerRadius="10" ClipToBounds="True" Margin="0,4,0,12" HorizontalAlignment="Left" Background="{StaticResource Space.Bg.ElevatedBrush}"
                    Visibility="{Binding Image, Converter={StaticResource NullToVisibility}}">
                <Image Source="{Binding Image}" Stretch="Uniform" MaxHeight="320" StretchDirection="DownOnly" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="{StaticResource Space.Page.Padding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title, catalog status, setup picker and setup actions -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="180" MaxWidth="440" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Bottom" Margin="0,0,16,0">
                <TextBlock Style="{StaticResource Space.PageTitle}" Text="Mods" />
                <DockPanel>
                    <ui:ProgressRing DockPanel.Dock="Right" IsIndeterminate="True" Width="14" Height="14" Margin="6,0,12,0" Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Style="{StaticResource Space.Style.Secondary}" Text="{Binding CatalogLine}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding CatalogLine}" />
                </DockPanel>
            </StackPanel>
            <!-- Wraps under itself on narrow windows instead of squeezing the title -->
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <StackPanel Margin="0,0,10,6">
                    <TextBlock Style="{StaticResource Space.Style.Overline}" Text="SETUP" Margin="2,0,0,4" />
                    <ComboBox ItemsSource="{Binding Setups}" SelectedItem="{Binding SelectedSetup}" Width="280" AutomationProperties.Name="Setup"
                              ToolTip="{Binding SetupKind}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type svc:SetupInfo}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding KindLabel}" FontSize="12" Foreground="{StaticResource Space.Text.SecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <ui:Button Content="New setup" Icon="{ui:SymbolIcon Add24}" Command="{Binding NewSetupCommand}" VerticalAlignment="Bottom" Margin="0,0,8,6" Height="40" />
                <ui:Button Icon="{ui:SymbolIcon ArrowImport24}" Command="{Binding ImportCommand}" VerticalAlignment="Bottom" Margin="0,0,8,6" Height="40"
                           ToolTip="Import a setup a friend shared" AutomationProperties.Name="Import" />
                <ui:Button Icon="{ui:SymbolIcon Share24}" Command="{Binding ShareCommand}" VerticalAlignment="Bottom" Margin="0,0,8,6" Height="40"
                           ToolTip="Share this setup's mods" AutomationProperties.Name="Share" />
                <ui:Button Content="Play" Icon="{ui:SymbolIcon Play24}" Appearance="Primary" Command="{Binding PlaySetupCommand}" VerticalAlignment="Bottom" Margin="0,0,8,6" Height="40"
                           ToolTip="Start KSP from this setup" Visibility="{Binding CanPlaySetup, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button Icon="{ui:SymbolIcon ArrowSync24}" Command="{Binding RefreshCommand}" VerticalAlignment="Bottom" Margin="0,0,8,6" Height="40" ToolTip="Download the latest CKAN mod list"
                           AutomationProperties.Name="Refresh the mod list" />
                <ui:Button Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenFolderCommand}" VerticalAlignment="Bottom" Margin="0,0,8,6" Height="40" ToolTip="Open the game folder"
                           AutomationProperties.Name="Open the game folder" />
                <ui:Button Icon="{ui:SymbolIcon Delete24}" Command="{Binding RemoveSetupCommand}" VerticalAlignment="Bottom" Margin="0,0,0,6" Height="40" ToolTip="Remove this setup"
                           AutomationProperties.Name="Remove this setup" Visibility="{Binding CanManageSetup, Converter={StaticResource BoolToVisibility}}" />
            </WrapPanel>
        </Grid>

        <!-- Notices -->
        <StackPanel Grid.Row="1">
            <ContentControl Content="{Binding Error}" ContentTemplate="{StaticResource ErrorCardTemplate}" Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}" Focusable="False" />
            <Border Style="{StaticResource Space.Card}" Padding="16,12" Margin="0,14,0,0" Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="LockClosed24" Foreground="{StaticResource Space.AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Style="{StaticResource Space.Style.Body}" Text="{Binding ReadOnlyReason}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <ui:Button Grid.Column="2" Content="Make a custom copy" Icon="{ui:SymbolIcon Copy24}" Command="{Binding MakeCustomCopyCommand}" Margin="12,0,0,0"
                               Visibility="{Binding IsPackSetup, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>
        </StackPanel>

        <!-- Tabs, search, filters -->
        <Grid Grid.Row="2" Margin="0,16,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:TextBox Grid.ColumnSpan="2" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Search 3,000+ mods by name, author or what they do"
                        Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True" AutomationProperties.Name="Search mods" FontSize="15" />
            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,12,0">
                <RadioButton Style="{StaticResource TabChip}" GroupName="modsTab" IsChecked="True" Command="{Binding SetTabCommand}" CommandParameter="browse" Content="Browse" />
                <RadioButton Style="{StaticResource TabChip}" GroupName="modsTab" Command="{Binding SetTabCommand}" CommandParameter="installed">
                    <TextBlock><Run Text="Installed " /><Run Text="{Binding InstalledCount, Mode=OneWay}" Foreground="{StaticResource Space.Text.SecondaryBrush}" /></TextBlock>
                </RadioButton>
                <RadioButton Style="{StaticResource TabChip}" GroupName="modsTab" Command="{Binding SetTabCommand}" CommandParameter="updates">
                    <TextBlock><Run Text="Updates " /><Run Text="{Binding UpdateCount, Mode=OneWay}" Foreground="{StaticResource Space.AccentBrush}" /></TextBlock>
                </RadioButton>
            </StackPanel>
            <WrapPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Margin="0,10,0,0">
                <ComboBox ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}" DisplayMemberPath="Label" Width="150" Margin="0,0,8,0" AutomationProperties.Name="Show"
                          IsEnabled="{Binding IsBrowseTab}" />
                <ComboBox ItemsSource="{Binding Tags}" SelectedItem="{Binding Tag}" Width="130" Margin="0,0,8,0" AutomationProperties.Name="Tag" />
                <ComboBox ItemsSource="{Binding Sorts}" SelectedItem="{Binding Sort}" DisplayMemberPath="Label" Width="150" AutomationProperties.Name="Sort by" />
            </WrapPanel>
        </Grid>

        <!-- List and details (the mod page sits beside the list, or over it when the window is narrow) -->
        <Grid Grid.Row="3" x:Name="ContentArea">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Space.Card}" Padding="6,6,4,6">
                <Grid>
                    <ListBox x:Name="ModList" ItemsSource="{Binding VisibleRows}" SelectedItem="{Binding SelectedRow}" Background="Transparent" BorderThickness="0"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Mods">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="OverridesDefaultStyle" Value="True" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Row" CornerRadius="12" Padding="12,10" Margin="0,1" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Cursor="Hand">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Space.Bg.ElevatedBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Space.Accent.SoftBrush}" />
                                                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Space.AccentBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Space.Stroke.StrongBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ModRowViewModel}">
                                <Grid Height="58">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="58" Height="58" CornerRadius="12" Background="{Binding PlaceholderBrush}">
                                        <Grid>
                                            <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.92" />
                                            <Border CornerRadius="12" Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisibility}}">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                        <TextBlock TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                            <Run Text="{Binding Name, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Space.Text.PrimaryBrush}" />
                                            <Run Text="  " /><Run Text="{Binding Author, Mode=OneWay}" FontSize="12" Foreground="{StaticResource Space.Text.SecondaryBrush}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Space.Style.Secondary}" FontSize="13" Margin="0,2,0,0" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                   ToolTip="{Binding Summary}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <ui:SymbolIcon Symbol="ArrowDownload16" FontSize="12" Foreground="{StaticResource Space.Text.SecondaryBrush}" Margin="0,0,3,0"
                                                           Visibility="{Binding Downloads, Converter={StaticResource NullToVisibility}}" />
                                            <TextBlock Style="{StaticResource Space.Style.Caption}" Text="{Binding Downloads}" Margin="0,0,12,0" />
                                            <TextBlock Style="{StaticResource Space.Style.Caption}" FontFamily="{StaticResource Space.Font.Mono}" Text="{Binding Version}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <Border Style="{StaticResource Space.Badge}" Background="{StaticResource Space.Accent.SoftBrush}" BorderBrush="{StaticResource Space.AccentBrush}" Margin="0,0,6,0"
                                                Visibility="{Binding PendingLabel, Converter={StaticResource NullToVisibility}}">
                                            <TextBlock Style="{StaticResource Space.Style.Caption}" Text="{Binding PendingLabel}" Foreground="{StaticResource Space.Text.PrimaryBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource Space.Badge}" BorderBrush="{Binding BadgeKind, Converter={StaticResource StatusKindToBrush}}"
                                                Visibility="{Binding Badge, Converter={StaticResource NullToVisibility}}">
                                            <TextBlock Style="{StaticResource Space.Style.Caption}" Text="{Binding Badge}" Foreground="{StaticResource Space.Text.PrimaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                    <ui:Button Grid.Column="3" Style="{StaticResource RowAction}" Content="{Binding ActionLabel}"
                                               Command="{Binding DataContext.ActCommand, ElementName=Root}" CommandParameter="{Binding}"
                                               Visibility="{Binding ActionLabel, Converter={StaticResource NullToVisibility}}" IsEnabled="{Binding CanActOrUndo}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Style="{StaticResource Space.Style.Secondary}" Text="No mods match. Try other words, or show Everything." Margin="18" HorizontalAlignment="Center"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
                    <Border Background="{StaticResource Space.Bg.LayerBrush}" CornerRadius="{StaticResource Space.Radius.Card}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:ProgressRing IsIndeterminate="True" Width="40" Height="40" />
                            <TextBlock Style="{StaticResource Space.Style.Secondary}" Text="{Binding LoadingText}" Margin="0,14,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Mod page -->
            <Border x:Name="DetailsPane" Grid.Column="1" Width="460" Margin="14,0,0,0" Style="{StaticResource Space.Card}" Padding="0" ClipToBounds="True"
                    DataContext="{Binding Details}" Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel d:DataContext="{d:DesignInstance vm:ModDetailsViewModel}">
                        <Grid Height="190">
                            <Border CornerRadius="16,16,0,0" Background="{Binding Row.PlaceholderBrush}" />
                            <Border CornerRadius="16,16,0,0" Visibility="{Binding Header, Converter={StaticResource NullToVisibility}}">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Header}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <Border CornerRadius="16,16,0,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00131628" Offset="0.35" />
                                        <GradientStop Color="#F0131628" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <ui:Button Icon="{ui:SymbolIcon Dismiss24}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Appearance="Secondary"
                                       Command="{Binding DataContext.CloseDetailsCommand, ElementName=Root}" ToolTip="Close" AutomationProperties.Name="Close the mod page" />
                            <StackPanel VerticalAlignment="Bottom" Margin="22,0,22,14">
                                <TextBlock Text="{Binding Entry.Name}" FontSize="24" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Row.Author}" FontSize="13" Foreground="#DDE2E6FF" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="22,14,22,22">
                            <TextBlock Style="{StaticResource Space.Style.Body}" Text="{Binding Entry.Abstract}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Space.Style.Caption}" Text="{Binding Stats}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBlock Style="{StaticResource Space.Style.Caption}" Text="{Binding Followers}" Margin="0,2,0,0" Visibility="{Binding Followers, Converter={StaticResource NullToVisibility}}" />
                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <ui:Button Style="{StaticResource RowAction}" DataContext="{Binding Row}" Content="{Binding ActionLabel}" MinWidth="120"
                                           Command="{Binding DataContext.ActCommand, ElementName=Root}" CommandParameter="{Binding}"
                                           Visibility="{Binding ActionLabel, Converter={StaticResource NullToVisibility}}" IsEnabled="{Binding CanActOrUndo}" />
                                <Border Style="{StaticResource Space.Badge}" DataContext="{Binding Row}" Margin="10,0,0,0" BorderBrush="{Binding BadgeKind, Converter={StaticResource StatusKindToBrush}}"
                                        Visibility="{Binding Badge, Converter={StaticResource NullToVisibility}}">
                                    <TextBlock Style="{StaticResource Space.Style.Caption}" Text="{Binding Badge}" Foreground="{StaticResource Space.Text.PrimaryBrush}" />
                                </Border>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Links}" Margin="-8,10,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ModLink}">
                                        <Button Style="{StaticResource Space.Button.Link}" Content="{Binding Label}" ToolTip="{Binding Url}"
                                                Command="{Binding DataContext.Details.OpenLinkCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ui:ProgressRing IsIndeterminate="True" Width="22" Height="22" HorizontalAlignment="Left" Margin="0,14,0,0" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Style="{StaticResource Space.Style.Caption}" Text="{Binding Note}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="{Binding Note, Converter={StaticResource NullToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Description}" Margin="0,16,0,0" />

                            <ItemsControl ItemsSource="{Binding Relations}" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:RelationGroup}">
                                        <StackPanel Margin="0,8,0,0">
                                            <TextBlock Style="{StaticResource Space.Style.Overline}" Text="{Binding Title}" Margin="0,0,0,6" />
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:RelationChip}">
                                                        <Button Margin="0,0,6,6" Cursor="Hand" Command="{Binding DataContext.Details.OpenRelationCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                                IsEnabled="{Binding Known}" ToolTip="{Binding Text}">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Chip" CornerRadius="12" Padding="10,4" Background="{StaticResource Space.Bg.ElevatedBrush}" BorderThickness="1"
                                                                            BorderBrush="{StaticResource Space.Stroke.SubtleBrush}">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <ui:SymbolIcon Symbol="CheckmarkCircle16" Filled="True" FontSize="12" Margin="0,0,4,0" Foreground="{StaticResource Space.Status.OnlineBrush}"
                                                                                           Visibility="{Binding Satisfied, Converter={StaticResource BoolToVisibility}}" />
                                                                            <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{StaticResource Space.Text.PrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="320" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource Space.AccentBrush}" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Expander Header="Versions" Margin="0,14,0,0" Visibility="{Binding HasVersions, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl ItemsSource="{Binding Versions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:VersionRow}">
                                            <StackPanel Margin="0,6,0,6">
                                                <TextBlock>
                                                    <Run Text="{Binding Version, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource Space.Text.PrimaryBrush}" />
                                                    <Run Text="  " /><Run Text="{Binding GameVersions, Mode=OneWay}" Foreground="{StaticResource Space.Text.SecondaryBrush}" FontSize="12" />
                                                    <Run Text="  " /><Run Text="{Binding Released, Mode=OneWay}" Foreground="{StaticResource Space.Text.SecondaryBrush}" FontSize="12" />
                                                    <Run Text="  " /><Run Text="{Binding Status, Mode=OneWay}" Foreground="{StaticResource Space.Status.WarningBrush}" FontSize="12" />
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource Space.Style.Caption}" Text="installed" Foreground="{StaticResource Space.Status.OnlineBrush}"
                                                           Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Style="{StaticResource Space.Style.Caption}" Text="{Binding Changelog}" TextWrapping="Wrap" Margin="0,2,0,0"
                                                           Visibility="{Binding Changelog, Converter={StaticResource NullToVisibility}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Queued changes -->
        <Border Grid.Row="4" Style="{StaticResource Space.Card.Accent}" Padding="18,12" Margin="0,12,0,0" Visibility="{Binding HasPending, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="TaskListSquareLtr24" Foreground="{StaticResource Space.AccentBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Style="{StaticResource Space.Style.Body}" FontWeight="SemiBold" Text="{Binding PendingLine}" VerticalAlignment="Center" />
                <Button Grid.Column="2" Style="{StaticResource Space.Button.Link}" Content="Clear" Command="{Binding ClearPendingCommand}" Margin="0,0,12,0" VerticalAlignment="Center" />
                <ui:Button Grid.Column="3" Content="Review and apply" Icon="{ui:SymbolIcon CheckmarkCircle24}" Appearance="Primary" Command="{Binding ReviewCommand}" />
            </Grid>
        </Border>
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Right">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Tab}" Value="updates" />
                                <Condition Binding="{Binding HasPending}" Value="False" />
                                <Condition Binding="{Binding IsReadOnly}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <ui:Button Content="Update all" Icon="{ui:SymbolIcon ArrowSync24}" Appearance="Primary" Command="{Binding UpdateAllCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
