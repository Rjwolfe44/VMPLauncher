<Page
    x:Class="VmpLauncher.App.Views.Pages.PlayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:VmpLauncher.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:PlayViewModel}"
    Title="Play">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource Space.Page.Padding}" MaxWidth="1100">
            <TextBlock Style="{StaticResource Space.Style.Display}" Text="Play" />
            <ContentControl Content="{Binding Error}" ContentTemplate="{StaticResource ErrorCardTemplate}" Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}" />
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource Space.Card}">
                        <StackPanel>
                            <DockPanel>
                                <ui:Button DockPanel.Dock="Right" Content="Check" Command="{Binding CheckRoutesCommand}" Icon="{ui:SymbolIcon ArrowSync24}" ToolTip="Re-check server status (F5)" />
                                <TextBlock Style="{StaticResource Space.SectionTitle}" Text="Server" />
                            </DockPanel>
                            <Border Padding="10,6" CornerRadius="8" Background="{StaticResource Space.Bg.ElevatedBrush}" Margin="0,0,0,8" Visibility="{Binding Maintenance, Converter={StaticResource NullToVisibility}}">
                                <TextBlock Style="{StaticResource Space.Style.Body}" Foreground="{StaticResource Space.Status.WarningBrush}" Text="{Binding Maintenance}" TextWrapping="Wrap" />
                            </Border>
                            <TextBlock Style="{StaticResource Space.Style.Secondary}" Text="{Binding Motd}" Margin="0,0,0,8" TextWrapping="Wrap" Visibility="{Binding Motd, Converter={StaticResource NullToVisibility}}" />
                            <ItemsControl ItemsSource="{Binding Routes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:RouteCardViewModel}">
                                        <RadioButton GroupName="routes" IsChecked="{Binding IsSelected, Mode=OneWay}" Margin="0,4"
                                                     Command="{Binding DataContext.SelectRouteCommand, RelativeSource={RelativeSource AncestorType=Page}}" CommandParameter="{Binding}"
                                                     AutomationProperties.Name="{Binding Name}">
                                            <Grid Margin="6,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource Space.Style.Body}" Text="{Binding Name}" />
                                                    <TextBlock Style="{StaticResource Space.Style.Caption}" Text="{Binding Address}" FontFamily="{StaticResource Space.Font.Mono}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="10" Height="10" Fill="{Binding StatusKind, Converter={StaticResource StatusKindToBrush}}" Margin="0,0,8,0" />
                                                    <TextBlock Style="{StaticResource Space.Style.Caption}" Text="{Binding Status}" />
                                                    <TextBlock Style="{StaticResource Space.Style.Caption}" Text="{Binding Rtt}" Margin="6,0,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </RadioButton>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Space.Style.Caption}" Text="{Binding RoutesSource}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Space.Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Space.SectionTitle}" Text="Ready to fly" />
                            <ItemsControl ItemsSource="{Binding Preflight}" ItemTemplate="{StaticResource RequirementRowTemplate}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding PolicyLine, Converter={StaticResource NullToVisibility}}">
                                <ui:SymbolIcon Symbol="{Binding PolicyOk, Converter={StaticResource BoolToSymbol}}" Foreground="{Binding PolicyOk, Converter={StaticResource BoolToStatusBrush}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource Space.Style.Caption}" Text="{Binding PolicyLine}" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Space.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Space.SectionTitle}" Text="You" />
                            <TextBlock Style="{StaticResource Space.Style.Caption}" Text="Player name" />
                            <ui:TextBox Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="1-15 letters, digits, _ or -" MaxLength="15" Margin="0,4,0,12" />
                            <TextBlock Style="{StaticResource Space.Style.Caption}" Text="Server password (saved only on this PC)" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <ui:PasswordBox x:Name="PasswordBox" Width="200" PlaceholderText="{Binding HasPassword, Converter={StaticResource PasswordPlaceholder}}" PasswordChanged="OnPasswordChanged" />
                                <ui:Button Content="Save" Command="{Binding SavePasswordCommand}" Margin="8,0,0,0" />
                                <ui:Button Content="Forget" Command="{Binding ForgetPasswordCommand}" Margin="8,0,0,0" Visibility="{Binding HasPassword, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Space.Card}" Margin="0,16,0,0" Background="{StaticResource Space.Bg.ElevatedBrush}">
                        <StackPanel>
                            <ui:Button Content="Play" Command="{Binding PlayCommand}" IsEnabled="{Binding CanPlay}" Appearance="Primary" HorizontalAlignment="Stretch" Padding="0,14" FontSize="20" FontWeight="SemiBold" Icon="{ui:SymbolIcon Rocket24}" />
                            <TextBlock Style="{StaticResource Space.Style.Caption}" Margin="0,10,0,0" Text="{Binding PlayHint}" TextWrapping="Wrap" />
                            <StackPanel Visibility="{Binding GameRunning, Converter={StaticResource BoolToVisibility}}" Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource Space.Style.Body}" Text="KSP is running." />
                                <TextBlock Style="{StaticResource Space.Style.Caption}" Text="First load of a big pack can take 5–15 minutes." />
                                <TextBlock Style="{StaticResource Space.Style.Caption}" Text="{Binding RunningSince, StringFormat=started {0}}" />
                                <TextBlock Style="{StaticResource Space.Style.Caption}" Margin="0,6,0,0" Text="When KSP loads: open the VMP window → pick the server → Connect." Visibility="{Binding AutoJoinSupported, Converter={StaticResource InvertedBoolToVisibility}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
