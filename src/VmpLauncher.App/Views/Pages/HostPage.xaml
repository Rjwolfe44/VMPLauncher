<UserControl
    x:Class="VmpLauncher.App.Views.Pages.HostPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:VmpLauncher.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:HostViewModel}">
    <ScrollViewer Style="{StaticResource Space.PageScroll}">
        <StackPanel Margin="{StaticResource Space.Page.Padding}" MaxWidth="1120">
            <TextBlock Style="{StaticResource Space.PageTitle}" Text="Host tools" />
            <TextBlock Style="{StaticResource Space.Style.Secondary}" Text="Only on your PC: publish a new pack version after changing mods, and make invite codes for friends." />
            <ContentControl Content="{Binding Error}" ContentTemplate="{StaticResource ErrorCardTemplate}" Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}" Focusable="False" />

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="2*" MinWidth="330" />
                </Grid.ColumnDefinitions>

                <!-- Publish -->
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource Space.Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Space.SectionTitle}" Text="Publish a pack update" />
                            <TextBlock Style="{StaticResource Space.Style.Secondary}" Text="1. Check: re-hashes the server mod list from your GameData, exports and signs the pack, and shows exactly what would happen. Nothing leaves this PC." />
                            <TextBlock Style="{StaticResource Space.Style.Secondary}" Margin="0,4,0,0" Text="2. Publish: uploads missing downloads (private mods only to your private repository), pushes the pack, and updates the server's mod list with a backup and restart when it changed." />
                            <TextBlock Style="{StaticResource Space.Style.Caption}" Margin="0,16,0,0" Text="What changed (goes into the changelog friends see)" />
                            <ui:TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" PlaceholderText="e.g. ApexGuidance: better ascent guidance" AcceptsReturn="True" MinHeight="64" TextWrapping="Wrap" />
                            <Expander Header="Added or removed a mod?" Margin="0,10,0,0">
                                <StackPanel Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource Space.Style.Caption}" Text="Only the game knows the part list. Start KSP, generate KSPModControl + SHA from the VMP options, close KSP, and pick that file here. For DLL-only mods you can allow the patched list instead." />
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:TextBox Text="{Binding GeneratedPolicy, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="(not needed for rebuilt mods)" FontFamily="{StaticResource Space.Font.Mono}" />
                                        <ui:Button Grid.Column="1" Content="Browse…" Command="{Binding BrowsePolicyCommand}" Margin="8,0,0,0" />
                                    </Grid>
                                    <CheckBox Content="Allow the patched mod list even though DLLs were added or removed" IsChecked="{Binding AllowPatchedPolicy}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Expander>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <ui:Button Content="Check" Command="{Binding CheckCommand}" Appearance="Primary" Icon="{ui:SymbolIcon Search24}" IsEnabled="{Binding IsWorking, Converter={StaticResource InvertBool}}" />
                                <ui:ProgressRing IsIndeterminate="True" Width="20" Height="20" Margin="12,0,0,0" Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <!-- Result -->
                            <Border Margin="0,16,0,0" Padding="16,14" CornerRadius="12" Background="{StaticResource Space.Bg.ElevatedBrush}" BorderThickness="1"
                                    BorderBrush="{Binding ResultKind, Converter={StaticResource StatusKindToBrush}}" Visibility="{Binding PlanHeadline, Converter={StaticResource NullToVisibility}}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="{Binding ResultKind, Converter={StaticResource StatusKindToSymbol}}" Filled="True" Foreground="{Binding ResultKind, Converter={StaticResource StatusKindToBrush}}" FontSize="20" Margin="0,0,10,0" />
                                        <TextBlock Style="{StaticResource Space.Style.Title}" FontSize="16" Text="{Binding PlanHeadline}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Space.Style.Secondary}" Margin="0,6,0,0" Text="{Binding PlanDetail}" />
                                    <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,8,0,0" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,3">
                                                    <ui:SymbolIcon Symbol="Warning24" Filled="True" Foreground="{StaticResource Space.Status.WarningBrush}" Margin="0,0,8,0" VerticalAlignment="Top" />
                                                    <TextBlock Style="{StaticResource Space.Style.Caption}" Foreground="{StaticResource Space.Text.PrimaryBrush}" Text="{Binding}" MaxWidth="560" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource Space.Style.Overline}" Text="WHAT PUBLISH WILL DO" Margin="0,12,0,4" Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibility}}" />
                                    <ItemsControl ItemsSource="{Binding Actions}" Focusable="False" Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:PlanAction}">
                                                <Expander Margin="0,2">
                                                    <Expander.Header>
                                                        <TextBlock Style="{StaticResource Space.Style.Body}" Text="{Binding Title}" />
                                                    </Expander.Header>
                                                    <TextBox Text="{Binding Commands, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="{StaticResource Space.Font.Mono}" FontSize="11"
                                                             Background="Transparent" BorderThickness="0" Foreground="{StaticResource Space.Text.SecondaryBrush}" />
                                                </Expander>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Margin="0,14,0,0" Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Style="{StaticResource Space.Style.Caption}" Text="Type PUBLISH to confirm. This is public and may restart the game server." />
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox Text="{Binding ConfirmText, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="PUBLISH" FontFamily="{StaticResource Space.Font.Mono}" />
                                            <ui:Button Grid.Column="1" Content="Publish" Command="{Binding PublishCommand}" IsEnabled="{Binding CanPublish}" Appearance="Danger" Icon="{ui:SymbolIcon CloudArrowUp24}" Margin="8,0,0,0" />
                                        </Grid>
                                        <TextBlock Style="{StaticResource Space.Style.Caption}" Margin="0,6,0,0" Text="Changed the notes? Run Check again first." />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Space.Card}" Margin="0,16,0,0" Padding="22,18,10,12">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,12,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Space.Button.Link}" Content="Copy log" Command="{Binding CopyLogCommand}" />
                                <TextBlock Style="{StaticResource Space.SectionTitle}" Text="Log" Margin="0" />
                            </DockPanel>
                            <ListBox ItemsSource="{Binding Log}" Height="300" Background="Transparent" BorderThickness="0" FontFamily="{StaticResource Space.Font.Mono}" FontSize="11.5"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.HorizontalScrollBarVisibility="Disabled" x:Name="LogList">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="OverridesDefaultStyle" Value="True" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter Margin="0,1" />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource Space.Text.SecondaryBrush}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- Right: invites + config -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Space.Card.Accent}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Space.SectionTitle}" Text="Invite a friend" />
                            <TextBlock Style="{StaticResource Space.Style.Secondary}" Text="One code gives a friend the server password and your private mods (they then update by themselves)." />

                            <StackPanel Visibility="{Binding HasPrivateRepos, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource Space.Style.Caption}" Margin="0,14,0,0" Text="Private mods repository" />
                                <ComboBox ItemsSource="{Binding Repos}" SelectedItem="{Binding SelectedRepo}" Margin="0,4,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding TokenKind, Converter={StaticResource StatusKindToBrush}}" />
                                    <TextBlock Style="{StaticResource Space.Style.Caption}" Foreground="{StaticResource Space.Text.PrimaryBrush}" Text="{Binding TokenState}" MaxWidth="300" />
                                </StackPanel>
                                <Expander Header="Set up or replace the read-only token" Margin="0,8,0,0">
                                    <StackPanel Margin="0,6,0,0">
                                        <TextBlock Style="{StaticResource Space.Style.Caption}" LineHeight="18"
                                                   Text="Opens GitHub with the name, Contents: read-only and no expiry filled in. Under Repository access choose Only select repositories and pick the private mods repository, then Generate token and paste it here. Never paste your own login token; every friend gets a copy of this one." />
                                        <Button Style="{StaticResource Space.Button.Link}" Content="Open GitHub's token page" Command="{Binding OpenTokenPageCommand}" HorizontalAlignment="Left" Margin="-6,6,0,0" />
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:PasswordBox x:Name="TokenBox" PlaceholderText="github_pat_..." PasswordChanged="OnTokenChanged" />
                                            <ui:Button Grid.Column="1" Content="Save" Command="{Binding SaveTokenCommand}" Margin="8,0,0,0" />
                                        </Grid>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Space.Style.Caption}" Margin="0,12,0,0" Visibility="{Binding HasPrivateRepos, Converter={StaticResource InvertedBoolToVisibility}}"
                                       Text="The pack has no private repository yet, so private mods are handed out as files. Invite codes can still carry the server password." />

                            <CheckBox Content="Include the server password" IsChecked="{Binding IncludePassword}" Margin="0,14,0,0" />
                            <ui:Button Content="Copy invite code" Command="{Binding CopyInviteCommand}" Appearance="Primary" Icon="{ui:SymbolIcon Copy24}" Margin="0,10,0,0" HorizontalAlignment="Stretch" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding InviteState, Converter={StaticResource NullToVisibility}}">
                                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Top" Fill="{Binding InviteKind, Converter={StaticResource StatusKindToBrush}}" />
                                <TextBlock Style="{StaticResource Space.Style.Caption}" Foreground="{StaticResource Space.Text.PrimaryBrush}" Text="{Binding InviteState}" MaxWidth="300" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Space.Card}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Space.SectionTitle}" Text="This PC's publish setup" />
                            <ItemsControl ItemsSource="{Binding ConfigLines}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ConfigLine}">
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Style="{StaticResource Space.Style.Caption}" Text="{Binding Label}" />
                                            <TextBlock Style="{StaticResource Space.Style.Mono}" FontSize="12" Text="{Binding Value}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
