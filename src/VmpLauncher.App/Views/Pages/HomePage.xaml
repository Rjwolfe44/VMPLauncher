<Page
    x:Class="VmpLauncher.App.Views.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:VmpLauncher.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:HomeViewModel}"
    Title="Home"
    AllowDrop="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource Space.Page.Padding}" MaxWidth="1100" HorizontalAlignment="Stretch">
            <!-- Hero -->
            <Border CornerRadius="{StaticResource Space.Radius.Hero}" Height="240" ClipToBounds="True" Background="{StaticResource Space.StarfieldBrush}">
                <Grid>
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#000B0D17" Offset="0.15" />
                                <GradientStop Color="#F00B0D17" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <ui:ProgressRing IsIndeterminate="True" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,16,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel VerticalAlignment="Bottom" Margin="28,0,28,22">
                        <TextBlock Style="{StaticResource Space.Style.Display}" Text="{Binding PackName}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource Space.Style.Secondary}" Text="by " />
                            <TextBlock Style="{StaticResource Space.Style.Secondary}" Text="{Binding PackAuthor}" />
                            <TextBlock Style="{StaticResource Space.Style.Secondary}" Text=" · " />
                            <TextBlock Style="{StaticResource Space.Style.Secondary}" Text="{Binding PackVersion}" />
                            <Border Style="{StaticResource Space.Badge}" Margin="14,0,0,0" BorderBrush="{Binding StateKind, Converter={StaticResource StatusKindToBrush}}">
                                <TextBlock Style="{StaticResource Space.Style.Caption}" Text="{Binding StateBadge}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                    <ui:Button Content="{Binding PrimaryAction}" Command="{Binding PrimaryCommand}" IsEnabled="{Binding PrimaryEnabled}"
                               Appearance="Primary" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,22" Padding="30,10" FontSize="16" FontWeight="SemiBold"
                               AutomationProperties.Name="{Binding PrimaryAction}" />
                </Grid>
            </Border>

            <ContentControl Content="{Binding Error}" ContentTemplate="{StaticResource ErrorCardTemplate}" Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}" />

            <!-- Private package drop zone -->
            <Border Style="{StaticResource Space.Card}" Margin="0,16,0,0" BorderBrush="{StaticResource Space.AccentBrush}" Visibility="{Binding NeedsSideload, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="FolderZip24" FontSize="28" Foreground="{StaticResource Space.AccentBrush}" Margin="0,0,16,0" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource Space.SectionTitle}" Text="Private package needed" Margin="0" />
                        <TextBlock Style="{StaticResource Space.Style.Secondary}" Text="{Binding SideloadHint}" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource Space.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Space.SectionTitle}" Text="Requirements" />
                        <ItemsControl ItemsSource="{Binding Requirements}" ItemTemplate="{StaticResource RequirementRowTemplate}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Space.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Space.SectionTitle}" Text="About this pack" />
                        <TextBlock Style="{StaticResource Space.Style.Body}" Text="{Binding PackDescription}" />
                        <TextBlock Style="{StaticResource Space.Style.Caption}" Margin="0,10,0,0" Text="{Binding FactsLine}" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <ui:SymbolIcon Symbol="{Binding TrustKind, Converter={StaticResource StatusKindToSymbol}}" Foreground="{Binding TrustKind, Converter={StaticResource StatusKindToBrush}}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Space.Style.Caption}" Text="{Binding TrustLine}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <ui:Button Content="Refresh" Command="{Binding RefreshCommand}" Icon="{ui:SymbolIcon ArrowSync24}" Margin="0,0,8,0" />
                            <ui:Button Content="Open game folder" Command="{Binding OpenProfileFolderCommand}" Icon="{ui:SymbolIcon FolderOpen24}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Space.Style.Caption}" Margin="0,8,0,0" Text="{Binding LastCheck}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
