<UserControl
    x:Class="VmpLauncher.App.Views.Dialogs.ShareView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:VmpLauncher.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:ShareViewModel}"
    MinWidth="560">
    <StackPanel>
        <TextBlock Style="{StaticResource Space.Style.Body}" Text="{Binding Summary}" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource Space.Style.Caption}" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="Your friend gets the same mods and versions from CKAN in a new copy of their KSP. Saves and settings are not shared." />

        <TextBlock Style="{StaticResource Space.Style.Overline}" Text="SHARE CODE" Margin="0,16,0,4" />
        <TextBox Text="{Binding Code, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                 FontFamily="{StaticResource Space.Font.Mono}" FontSize="12" AutomationProperties.Name="Share code" />
        <TextBlock Style="{StaticResource Space.Style.Caption}" Text="{Binding CodeNote}" TextWrapping="Wrap" Margin="0,6,0,0" />

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <ui:Button Content="Copy code" Icon="{ui:SymbolIcon Copy24}" Command="{Binding CopyCodeCommand}" Margin="0,0,8,0"
                       Appearance="Primary" Visibility="{Binding CodeFits, Converter={StaticResource BoolToVisibility}}" />
            <ui:Button Content="Save as file…" Icon="{ui:SymbolIcon Save24}" Command="{Binding SaveFileCommand}" />
            <TextBlock Style="{StaticResource Space.Style.Caption}" Text="{Binding Status}" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{StaticResource Space.Status.OnlineBrush}" />
        </StackPanel>

        <TextBlock Style="{StaticResource Space.Style.Caption}" Text="{Binding NotSharedLine}" TextWrapping="Wrap" Margin="0,14,0,0"
                   Visibility="{Binding HasNotShared, Converter={StaticResource BoolToVisibility}}" />
    </StackPanel>
</UserControl>
