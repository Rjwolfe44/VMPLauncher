<UserControl
    x:Class="VmpLauncher.App.Views.Dialogs.ImportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:VmpLauncher.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:ImportViewModel}"
    MinWidth="580">
    <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,10,0">
            <TextBlock Style="{StaticResource Space.Style.Secondary}" TextWrapping="Wrap"
                       Text="Paste a share code from a friend, or open the .vmpack file they sent. Nothing is installed until you review the changes." />
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="VMPSHARE1-…" TextWrapping="Wrap" AcceptsReturn="False" MaxHeight="90"
                            VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource Space.Font.Mono}" FontSize="12" AutomationProperties.Name="Share code" />
                <ui:Button Grid.Column="1" Content="Open file…" Icon="{ui:SymbolIcon FolderOpen24}" Command="{Binding OpenFileCommand}" Margin="8,0,0,0" VerticalAlignment="Top" />
            </Grid>
            <TextBlock Style="{StaticResource Space.Style.Caption}" Text="{Binding Error}" Foreground="{StaticResource Space.Status.ErrorBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                       Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}" />

            <StackPanel Visibility="{Binding Setup, Converter={StaticResource NullToVisibility}}">
                <TextBlock Style="{StaticResource Space.Style.Body}" FontWeight="SemiBold" Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,14,0,0" />
                <ItemsControl ItemsSource="{Binding Preview}" Margin="0,6,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10" Padding="8,3" Margin="0,0,6,6" Background="{StaticResource Space.Bg.ElevatedBrush}">
                                <TextBlock Text="{Binding}" FontSize="12" Foreground="{StaticResource Space.Text.PrimaryBrush}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource Space.Style.Overline}" Text="WHERE" Margin="0,12,0,4" />
                <RadioButton GroupName="importWhere" IsChecked="{Binding NewCopy}" Content="A new copy of KSP (recommended: keeps your other setups as they are)" Margin="0,2" />
                <RadioButton GroupName="importWhere" IsChecked="{Binding NewCopy, Converter={StaticResource InvertBool}}" IsEnabled="{Binding CanUseCurrent}" Margin="0,2">
                    <TextBlock>
                        <Run Text="Add to the current setup: " /><Run Text="{Binding Current.Name, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                </RadioButton>
                <StackPanel DataContext="{Binding Target}" Margin="26,8,0,0" Visibility="{Binding DataContext.NewCopy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource Space.Style.Caption}" Text="Name" Margin="0,0,0,4" />
                    <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="60" AutomationProperties.Name="Setup name" />
                    <TextBlock Style="{StaticResource Space.Style.Caption}" Text="Copy the game from" Margin="0,10,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Installs}" SelectedItem="{Binding SelectedInstall}" DisplayMemberPath="Label" AutomationProperties.Name="KSP folder" />
                        <ui:Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseCommand}" Margin="8,0,0,0" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
