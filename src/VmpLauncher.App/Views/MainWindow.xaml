<ui:FluentWindow
    x:Class="VmpLauncher.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:VmpLauncher.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:MainWindowViewModel}"
    Title="VMP Launcher"
    Width="1240" Height="800" MinWidth="980" MinHeight="640"
    WindowStartupLocation="Manual"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="None"
    WindowCornerPreference="Round"
    Background="{StaticResource Space.Bg.BaseBrush}"
    FontFamily="{StaticResource Space.Font.Text}">

    <Window.Resources>
        <DataTemplate x:Key="NavRadioTemplate" DataType="{x:Type vm:NavItem}">
            <RadioButton Style="{StaticResource Space.NavButton}" GroupName="nav"
                         IsChecked="{Binding IsActive, Mode=TwoWay}"
                         Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                         CommandParameter="{Binding}"
                         Content="{Binding}" ContentTemplate="{StaticResource NavItemTemplate}"
                         Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}"
                         ToolTip="{Binding Shortcut}"
                         AutomationProperties.Name="{Binding Label}" />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource Space.WindowBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Rectangle Grid.ColumnSpan="2" Fill="{StaticResource Space.NebulaBrush}" IsHitTestVisible="False" />
        <Rectangle Grid.ColumnSpan="2" Fill="{StaticResource Space.NebulaBlueBrush}" IsHitTestVisible="False" />

        <!-- ===== Sidebar ===== -->
        <Border Grid.Column="0" Width="248" Background="{StaticResource Space.Bg.SidebarBrush}"
                BorderBrush="{StaticResource Space.Stroke.SubtleBrush}" BorderThickness="0,0,1,0"
                Visibility="{Binding IsOnboarding, Converter={StaticResource InvertedBoolToVisibility}}">
            <DockPanel>
                <!-- Brand: also a drag handle for the window -->
                <Border DockPanel.Dock="Top" Padding="22,20,16,18" Background="Transparent" MouseLeftButtonDown="OnDragAreaMouseDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="40" Height="40">
                            <Ellipse Fill="{StaticResource Space.AccentBrush}" Opacity="0.22">
                                <Ellipse.Effect>
                                    <BlurEffect Radius="14" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <Image Source="pack://application:,,,/VmpLauncher;component/Assets/VmpLauncher-256.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="VMP Launcher" FontFamily="{StaticResource Space.Font.Ui}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Space.Text.PrimaryBrush}" />
                            <TextBlock Text="{Binding PackLine}" Style="{StaticResource Space.Style.Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding PackTooltip}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Bottom: update pill, server status, footer navigation -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,14">
                    <Button Style="{StaticResource Space.Button.Link}" Margin="14,0,14,8" HorizontalAlignment="Stretch"
                            Command="{Binding RestartToUpdateCommand}"
                            Visibility="{Binding Updates.UpdateReady, Converter={StaticResource BoolToVisibility}}"
                            ToolTip="A new launcher version is downloaded. It installs by itself when you close the launcher; click to restart into it now.">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowCircleUp24" Filled="True" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Updates.AvailableVersion, StringFormat=Launcher {0} ready: restart now}" />
                        </StackPanel>
                    </Button>

                    <Border Margin="14,0,14,12" Padding="14,12" CornerRadius="12" Background="{StaticResource Space.Bg.LayerBrush}"
                            BorderBrush="{StaticResource Space.Stroke.SubtleBrush}" BorderThickness="1" ToolTip="{Binding Server.SummaryDetail}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="12" Height="12" VerticalAlignment="Top" Margin="0,4,10,0">
                                <Ellipse Fill="{Binding Server.SummaryKind, Converter={StaticResource StatusKindToBrush}}" Opacity="0.35">
                                    <Ellipse.Effect>
                                        <BlurEffect Radius="6" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <Ellipse Width="9" Height="9" Fill="{Binding Server.SummaryKind, Converter={StaticResource StatusKindToBrush}}" />
                            </Grid>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Server.Summary}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Space.Text.PrimaryBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Server.SummaryDetail}" Style="{StaticResource Space.Style.Caption}" Visibility="{Binding Server.SummaryDetail, Converter={StaticResource NullToVisibility}}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding FooterItems}" ItemTemplate="{StaticResource NavRadioTemplate}" Focusable="False" />
                </StackPanel>

                <!-- Main navigation -->
                <ItemsControl ItemsSource="{Binding NavItems}" ItemTemplate="{StaticResource NavRadioTemplate}" Margin="0,4,0,0" Focusable="False" />
            </DockPanel>
        </Border>

        <!-- ===== Content ===== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="" Height="44" ShowHelp="False" Background="Transparent" />

            <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False" IsTabStop="False" />

            <!-- Activity strip: progress of a running install/update while you browse other pages -->
            <Border Grid.Row="2" Margin="24,0,24,16" Padding="16,12" CornerRadius="14"
                    Background="{StaticResource Space.Bg.ElevatedBrush}" BorderBrush="#FF3A2F78" BorderThickness="1"
                    Visibility="{Binding ActivityVisible, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:ProgressRing Grid.Column="0" IsIndeterminate="True" Width="22" Height="22" Margin="0,0,14,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ActivityTitle}" FontWeight="SemiBold" Foreground="{StaticResource Space.Text.PrimaryBrush}" />
                        <TextBlock Text="{Binding ActivityText}" Style="{StaticResource Space.Style.Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <ProgressBar Style="{StaticResource Space.Progress}" Height="4" Margin="0,8,0,0" Value="{Binding ActivityPercent, Mode=OneWay}" IsIndeterminate="{Binding ActivityIndeterminate}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <ui:Button Content="Details" Command="{Binding OpenActivityCommand}" Margin="0,0,8,0" />
                        <ui:Button Content="Cancel" Command="{Binding CancelActivityCommand}" Icon="{ui:SymbolIcon Dismiss24}" />
                    </StackPanel>
                </Grid>
            </Border>

            <ui:SnackbarPresenter x:Name="SnackbarPresenter" Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="Bottom" Margin="24" />
        </Grid>

        <ui:ContentDialogHost x:Name="DialogHost" Grid.ColumnSpan="2" />
    </Grid>
</ui:FluentWindow>
