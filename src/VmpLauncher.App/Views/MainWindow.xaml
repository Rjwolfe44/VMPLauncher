<ui:FluentWindow
    x:Class="VmpLauncher.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:pages="clr-namespace:VmpLauncher.App.Views.Pages"
    xmlns:vm="clr-namespace:VmpLauncher.App.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance vm:MainWindowViewModel}"
    Title="VMP Launcher"
    Width="1180" Height="760" MinWidth="900" MinHeight="600"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    Background="{StaticResource Space.Bg.BaseBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="TitleBar"
            Grid.Row="0"
            Title="VMP Launcher"
            CloseWindowByDoubleClickOnIcon="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/VmpLauncher;component/Assets/VmpLauncher-256.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ui:NavigationView
            x:Name="RootNavigation"
            Grid.Row="1"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="False"
            OpenPaneLength="200"
            Transition="FadeInWithSlide"
            TransitionDuration="200"
            FrameMargin="0"
            Padding="0">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Home" TargetPageType="{x:Type pages:HomePage}" ToolTip="Home (Ctrl+1)">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Home24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Play" TargetPageType="{x:Type pages:PlayPage}" ToolTip="Play (Ctrl+2)">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Rocket24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Activity" TargetPageType="{x:Type pages:InstallPage}" ToolTip="Downloads and install activity (Ctrl+3)">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="ArrowDownload24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Doctor" TargetPageType="{x:Type pages:DoctorPage}" ToolTip="Connection Doctor (Ctrl+4)">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Stethoscope24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Mods" TargetPageType="{x:Type pages:ModsPage}" ToolTip="Mod browser (Ctrl+5)">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="PuzzlePiece24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Settings" TargetPageType="{x:Type pages:SettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="About" TargetPageType="{x:Type pages:AboutPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Info24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <!-- Persistent activity strip: visible only while an operation is running. -->
        <Border Grid.Row="2"
                Background="{StaticResource Space.Bg.ElevatedBrush}"
                BorderBrush="{StaticResource Space.Stroke.SubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,8"
                Visibility="{Binding ActivityVisible, Converter={StaticResource BoolToVisibility}}">
            <DockPanel LastChildFill="True">
                <ui:SymbolIcon Symbol="ArrowDownload24" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{StaticResource Space.AccentBrush}" />
                <TextBlock Style="{StaticResource Space.Style.Caption}" VerticalAlignment="Center" Text="{Binding ActivityText}" />
            </DockPanel>
        </Border>

        <ui:SnackbarPresenter x:Name="SnackbarPresenter" Grid.Row="1" VerticalAlignment="Bottom" Margin="24" />
        <ui:ContentDialogHost x:Name="DialogHost" Grid.Row="0" Grid.RowSpan="3" />
    </Grid>
</ui:FluentWindow>
