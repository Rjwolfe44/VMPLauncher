{
  "schema": "vmpack/1",
  "id": "vmp-train-career",
  "name": "VMP Train Career",
  "author": "Rjwolfe44",
  "version": "2026.10.22.2",
  "description": "Career multiplayer world on trainpc: 180 CKAN mods, the VMP client and ApexGuidance, pinned to the exact versions the server expects.",
  "game": {
    "kspVersion": "1.12.5",
    "buildId64": "03190",
    "requiredDlc": [
      { "identifier": "MakingHistory-DLC", "folder": "SquadExpansion/MakingHistory", "version": "1.12.1", "policyName": "MakingHistory" },
      { "identifier": "BreakingGround-DLC", "folder": "SquadExpansion/Serenity", "version": "1.7.1", "policyName": "Serenity" }
    ],
    "compatibleGameVersions": [ "1.12", "1.11", "1.10", "1.9", "1.8", "1.7", "1.6" ]
  },
  "ckan": {
    "source": "registry",
    "modules": [],
    "metapackages": [],
    "withRecommends": false
  },
  "customPackages": [
    {
      "id": "VMPCustom-VladMultiplayer",
      "name": "Vlad Multiplayer (VMP client)",
      "abstract": "VMP multiplayer client, built from the Rjwolfe44/VMP fork of LunaMultiplayer.",
      "license": "MIT",
      "sourceDir": "..\\..\\..\\VMP\\VMPMod\\Build\\Release\\Client",
      "installAs": "GameData/VladMultiplayer",
      "versionFrom": { "assemblyInformationalVersion": "Plugins/LmpClient.dll" },
      "exclude": [ "Data/**", "Traces/**", "logs/**" ],
      "provides": [],
      "conflicts": [ "LunaMultiplayer", "LunaCompat" ],
      "distribution": { "kind": "github-release", "repo": "Rjwolfe44/VMP", "tagPrefix": "client-" }
    },
    {
      "id": "VMPCustom-ApexGuidance",
      "name": "ApexGuidance",
      "abstract": "Private MechJeb2 fork with advanced guidance solvers. Distributed by the host only.",
      "license": "GPL-3.0",
      "sourceDir": "..\\..\\..\\ApexGuidance\\publish\\GameData\\ApexGuidance",
      "installAs": "GameData/ApexGuidance",
      "versionFrom": { "gitDescribe": "..\\..\\..\\ApexGuidance\\MechJeb2" },
      "exclude": [ "Plugins/PluginData/**" ],
      "provides": [],
      "conflicts": [ "MechJeb2" ],
      "distribution": { "kind": "private-sideload", "hint": "Ask Chevy for the ApexGuidance zip for this pack version." }
    }
  ],
  "overrides": [],
  "fileRules": {
    "generated": [
      "GameData/ModuleManager.ConfigCache", "GameData/ModuleManager.ConfigSHA", "GameData/ModuleManager.Physics",
      "GameData/ModuleManager.TechTree", "GameData/toolbar-settings.dat", "GameData/**/*.log", "GameData/**/*.tmp",
      "GameData/ScattererAtmosphereCache/**", "GameData/**/ScattererAtmosphereCache/**",
      "GameData/Sigma/Replacements/Settings.cfg",
      "GameData/**/Cache/**", "GameData/**/*.hash", "GameData/**/*.TechTree",
      "GameData/Kopernicus/Config/Kopernicus_Config.cfg", "GameData/Astrogator/AstrogatorSettings.cfg",
      "GameData/KerbalKonstructs/PluginDataWindowPositions.cfg", "GameData/KSP-AVC/Plugins/KSP-AVC.xml"
    ],
    "perPlayer": [ "GameData/VladMultiplayer/Data/**", "GameData/VladMultiplayer/Traces/**", "GameData/VladMultiplayer/logs/**", "GameData/ApexGuidance/Plugins/PluginData/**" ],
    "mutableOwned": [ "GameData/**/PluginData/**", "GameData/KerbalEngineer/Settings/**", "GameData/AtmosphereAutopilot/Global_settings.txt", "GameData/RocketSoundEnhancement/Settings.cfg" ],
    "stock": [ "GameData/Squad/**", "GameData/SquadExpansion/**" ]
  },
  "multiplayer": {
    "requiredClientVersion": "auto",
    "servers": [
      { "name": "Train - Playit", "address": "signaling-karma.tun.ply.gg", "port": 18113, "exportable": true },
      { "name": "Train - ZeroTier", "address": "10.37.239.191", "port": 8800, "exportable": true },
      { "name": "Train - LAN", "address": "192.168.50.115", "port": 8800, "exportable": false }
    ],
    "policyUrl": "https://raw.githubusercontent.com/Rjwolfe44/VMP-Packs/main/packs/vmp-train-career/KSPModControl.xml",
    "serverDirectoryUrl": "https://raw.githubusercontent.com/Rjwolfe44/VMP-Packs/main/packs/vmp-train-career/servers.json"
  },
  "links": {
    "changelog": "https://github.com/Rjwolfe44/VMP-Packs/blob/main/packs/vmp-train-career/CHANGELOG.md"
  }
}
